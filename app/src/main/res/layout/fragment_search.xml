<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.search.view.SearchFragment">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/categoriesButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:text="All Categories"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:backgroundTint="@color/crater_brown_darker"
        app:cornerRadius="12dp"
        app:endIconTint="@color/white"
        app:icon="@drawable/all_categories"
        app:iconGravity="start"
        app:iconPadding="12dp"
        app:iconTint="@color/oriental_pink"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline2"
        app:layout_constraintTop_toTopOf="@+id/countriesButton"

        app:strokeColor="@color/oriental_pink"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/countriesButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:text="All Countries"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:backgroundTint="@color/crater_brown_darker"
        app:cornerRadius="12dp"
        app:endIconTint="@color/white"
        app:icon="@drawable/all_countries"
        app:iconGravity="start"
        app:iconPadding="12dp"
        app:iconTint="@color/oriental_pink"

        app:layout_constraintEnd_toStartOf="@+id/guideline2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/oriental_pink"
        app:strokeWidth="1dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent=".5" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:src="@drawable/down_icon"
        app:layout_constraintBottom_toBottomOf="@+id/countriesButton"
        app:layout_constraintEnd_toEndOf="@+id/countriesButton"
        app:layout_constraintTop_toTopOf="@+id/countriesButton" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:src="@drawable/down_icon"
        app:layout_constraintBottom_toBottomOf="@+id/categoriesButton"
        app:layout_constraintEnd_toEndOf="@+id/categoriesButton"
        app:layout_constraintTop_toTopOf="@+id/categoriesButton" />

</androidx.constraintlayout.widget.ConstraintLayout>