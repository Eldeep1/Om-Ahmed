<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fillViewport="true"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loginScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp"
        tools:context=".presentation.Authentication.login.view.LoginFragment">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent=".45" />

        <ImageView
            android:id="@+id/loginPageImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/food_image_of_the_login_page"
            android:scaleType="fitXY"
            android:src="@drawable/login_image"
            app:layout_constraintBottom_toTopOf="@+id/guideline4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />

        <TextView
            android:id="@+id/loginPageTitle"
            style="@style/Text.OmAhmed.AuthTitles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/welcome_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loginPageImage" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/loginEmail"
            style="@style/Widget.OmAhmed.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loginPageTitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/loginEmailEditText"
                style="@style/Widget.OmAhmed.InputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="@string/email"
                android:inputType="textEmailAddress" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/loginPassword"
            style="@style/Widget.OmAhmed.InputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="@id/loginEmail"
            app:layout_constraintStart_toStartOf="@id/loginEmail"
            app:layout_constraintTop_toBottomOf="@id/loginEmail"
            app:passwordToggleEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/loginPasswordEditText"
                style="@style/Widget.OmAhmed.InputEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:hint="@string/password"
                android:inputType="textPassword" />

        </com.google.android.material.textfield.TextInputLayout>


        <Button
            android:id="@+id/loginButton"
            style="@style/Text.OmAhmed.onBoardingButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@id/loginPassword"
            app:layout_constraintStart_toStartOf="@id/loginPassword"
            app:layout_constraintTop_toBottomOf="@id/loginPassword" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginGoogleButton"
            style="@style/Widget.OmAhmed.SocialButton"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:text="@string/google"
            app:icon="@drawable/google_icon"
            app:layout_constraintEnd_toStartOf="@+id/loginFacebookButton"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="@id/loginButton"
            app:layout_constraintTop_toBottomOf="@id/loginButton"
            app:rippleColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginFacebookButton"
            style="@style/Widget.OmAhmed.SocialButton"
            android:layout_marginStart="8dp"
            android:text="@string/facebook"
            app:icon="@drawable/facebook_icon"
            app:layout_constraintEnd_toEndOf="@id/loginButton"
            app:layout_constraintStart_toEndOf="@id/loginGoogleButton"
            app:layout_constraintTop_toTopOf="@id/loginGoogleButton" />


        <Button
            android:id="@+id/loginGuestButton"
            style="@style/Text.OmAhmed.guestButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/continue_as_guest"

            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@id/loginButton"
            app:layout_constraintStart_toStartOf="@id/loginButton"
            app:layout_constraintTop_toBottomOf="@id/loginGoogleButton" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/loginGuestButton">

            <TextView
                android:id="@+id/signUpText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/don_t_have_an_account"
                android:textColor="@color/oriental_pink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/signUpTextAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/sign_up"
                android:textColor="@color/button_color"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/loginLoadingOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/loginScreen"
            app:layout_constraintEnd_toEndOf="@id/loginScreen"
            app:layout_constraintStart_toStartOf="@id/loginScreen"
            app:layout_constraintTop_toTopOf="@id/loginScreen">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/loginLottieAnimation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                app:lottie_autoPlay="false"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loginlottieload" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
