        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Text.OmAhmed.mealOfTheDayCategoriesListItem" parent="Text_OmAhmed">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textColor">@color/white_80_opacity</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.OmAhmed.dailyRecommendationFoodName" parent="Text_OmAhmed">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.OmAhmed.guestButton" parent="Text_OmAhmed">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/oriental_pink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/guest_login_button</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="Theme.OmAhmed" parent="Base.Theme.OmAhmed" />


    <style name="Widget.OmAhmed.InputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/crater_brown</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeColor">@android:color/transparent</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.OmAhmed.InputEditText" parent="Widget.Material3.TextInputEditText.FilledBox">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/oriental_pink</item>
        <item name="android:padding">@dimen/input_padding</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@null</item>
    </style>

    <style name="Widget.OmAhmed.SocialButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/google_button_background</item>
        <item name="backgroundTint">@null</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>

        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@null</item>
    </style>
    <style name="RoundedBottomCorners">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomLeft">30dp</item>
        <item name="cornerSizeBottomRight">30dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
    </style>

    <style name="Text.OmAhmed.addToPlannerButton" parent="Text_OmAhmed">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textColor">@color/button_color</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/add_to_planner_button_background</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="ThemeOverlay.App.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/really_red</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="android:background">@color/crater_brown</item>
        <item name="colorOnSurface">@color/white_70_percent</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
    </style>

    <style name="CalendarWeekdayHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#CCFFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>